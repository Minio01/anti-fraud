# Скопируй этот файл в .env и заполни значения:  cp .env.example .env
# .env в git не попадает (см. .gitignore).

# --- PostgreSQL ---
# TODO(you): придумай имя БД, пользователя и пароль.
# Эти же значения потом пропишешь в application.yml persistence-worker.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
# TODO(you): сколько памяти отдать Redis. Прикинь: ~10 000 пользователей,
# в окне 60 минут у каждого до сотен записей ZSET по ~100 байт. Формат: 256mb, 1gb.
REDIS_MAXMEMORY=

# --- Kafka ---
KAFKA_PORT=9092
KAFKA_UI_PORT=8089

# --- Наблюдаемость ---
# 9090 занят gRPC scoring-service, поэтому Prometheus снаружи на 9091
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
# TODO(you): логин и пароль администратора Grafana
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
